# Адрес панели. Если бот и панель на одной машине — оставьте как есть.
PANEL_URL=http://127.0.0.1:8787

# API-токен панели с правами admin: Настройки -> Аккаунты и права -> API-токены.
PANEL_TOKEN=

# Токен бота брать не нужно: он задаётся в мастере настройки панели
# (http://127.0.0.1:8787/setup.html -> Discord -> Токен бота).
# Эта строка — только если по какой-то причине хочется хранить его у бота.
# DISCORD_TOKEN=
